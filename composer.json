{
    "name": "onix-systems-php/hyperf-inertia",
    "type": "library",
    "description": "The Hyperf adapter for Inertia.js.",
    "keywords": [
        "hyperf",
        "inertia"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Jonathan Reinink",
            "email": "jonathan@reinink.ca",
            "homepage": "https://reinink.ca"
        },
        {
            "name": "Alex Syvolap",
            "email": "oleksandr.syvolap@onix-systems.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8",
        "hyperf/collection": "~3.2.0",
        "hyperf/command": "~3.2.0",
        "hyperf/config": "~3.2.0",
        "hyperf/context": "~3.2.0",
        "hyperf/contract": "~3.2.0",
        "hyperf/guzzle": "~3.2.0",
        "hyperf/http-message": "~3.2.0",
        "hyperf/http-server": "~3.2.0",
        "hyperf/macroable": "~3.2.0",
        "hyperf/resource": "~3.2.0",
        "hyperf/session": "~3.2.0",
        "hyperf/stringable": "~3.2.0",
        "hyperf/support": "~3.2.0",
        "hyperf/view": "~3.2.0",
        "hyperf/view-engine": "~3.2.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "symfony/process": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "hyperf/testing": "~3.2.0",
        "hyperf/validation": "~3.2.0",
        "mockery/mockery": "^1.3",
        "phpstan/phpstan": "^1.10 || ^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0",
        "roave/security-advisories": "dev-latest"
    },
    "suggest": {
        "ext-pcntl": "Recommended when running the Inertia SSR server via the `inertia:start-ssr` command.",
        "hyperf/validation": "Required to handle validation errors in the Inertia middleware."
    },
    "autoload": {
        "psr-4": {
            "OnixSystemsPHP\\HyperfInertia\\": "src"
        },
        "files": [
            "helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "OnixSystemsPHP\\HyperfInertia\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml --colors=always",
        "analyse": "phpstan analyse -c phpstan.neon.dist --no-progress --memory-limit=1G",
        "cs-fix": "php-cs-fixer fix $1"
    },
    "extra": {
        "hyperf": {
            "config": "OnixSystemsPHP\\HyperfInertia\\ConfigProvider"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
